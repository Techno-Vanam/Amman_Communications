{
  "openapi": "3.0.3",
  "info": {
    "title": "Amman Communications — Application & Document Management API",
    "description": "API specification for Amman Communications service applications, client-encrypted document storage (AES-256-GCM), live synchronization, and admin verification desk.",
    "version": "1.0.0",
    "contact": {
      "name": "Amman Communications Support",
      "email": "support@ammancommunications.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Web Proxy (Port 3000)"
    },
    {
      "url": "http://localhost:3003/api/v1",
      "description": "Direct API Server (Port 3003)"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT access token"
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Operation successful" },
          "data": { "type": "object" }
        }
      },
      "CreateApplicationDto": {
        "type": "object",
        "required": ["serviceType", "fullName", "email", "phone"],
        "properties": {
          "serviceType": {
            "type": "string",
            "example": "PASSPORT_SERVICE",
            "enum": [
              "PASSPORT_SERVICE",
              "VISA_SERVICE",
              "COMPANY_REGISTRATION",
              "CITIZEN_SERVICES",
              "DOCUMENT_ATTESTATION"
            ]
          },
          "title": { "type": "string", "example": "Passport Application & Renewal" },
          "fullName": { "type": "string", "example": "Ashwath Krishna" },
          "email": { "type": "string", "format": "email", "example": "ashwath@example.com" },
          "phone": { "type": "string", "example": "+91 9876543210" },
          "dateOfBirth": { "type": "string", "example": "1998-05-15" },
          "nationality": { "type": "string", "example": "Indian" },
          "address": { "type": "string", "example": "123 Anna Salai, Chennai" },
          "notes": { "type": "string", "example": "Urgent renewal requested" }
        }
      },
      "UpdateApplicationDto": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "serviceType": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "dateOfBirth": { "type": "string" },
          "nationality": { "type": "string" },
          "address": { "type": "string" },
          "notes": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED"]
          }
        }
      },
      "DirectUploadDocumentDto": {
        "type": "object",
        "required": ["documentType", "fileName", "mimeType", "fileSize", "base64Data"],
        "properties": {
          "documentType": { "type": "string", "example": "NATIONAL_ID_PROOF" },
          "fileName": { "type": "string", "example": "aadhaar_card_scan.pdf" },
          "mimeType": { "type": "string", "example": "application/pdf" },
          "fileSize": { "type": "integer", "example": 204800 },
          "base64Data": {
            "type": "string",
            "description": "Base64 data URL string (max 10MB file size)",
            "example": "data:application/pdf;base64,VGhpcyBpcyBhbiBhYWRoYWFyIGNhcmQgc2NhbiBjb250ZW50..."
          }
        }
      },
      "UpdateDocumentStatusDto": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["UPLOADED", "UNDER_REVIEW", "VERIFIED", "REJECTED", "ACTION_REQUIRED"],
            "example": "VERIFIED"
          },
          "rejectionReason": {
            "type": "string",
            "example": "Photo background has glare. Please upload a clear 300 DPI scan."
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "customer@amman.com" },
          "password": { "type": "string", "example": "password123" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health Check",
        "description": "Verify API server and database availability",
        "responses": {
          "200": {
            "description": "System is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardResponse" }
              }
            }
          }
        }
      }
    },
    "/customer/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Customer Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful, returns JWT access token"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/admin/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Admin Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin login successful, returns JWT access token"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/customer/services-catalog": {
      "get": {
        "tags": ["Services Catalog"],
        "summary": "Get Services & Required Document Checklist",
        "description": "Returns all 5 services and their required document specifications",
        "responses": {
          "200": {
            "description": "List of services with requirements",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardResponse" }
              }
            }
          }
        }
      }
    },
    "/customer/applications": {
      "get": {
        "tags": ["Customer Applications"],
        "summary": "List Customer Applications",
        "description": "Get all service applications submitted by the customer with attached document counts",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of customer applications"
          }
        }
      },
      "post": {
        "tags": ["Customer Applications"],
        "summary": "Create New Service Application",
        "description": "Submit applicant details to initialize a new application record in the database",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateApplicationDto" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created successfully"
          }
        }
      }
    },
    "/customer/applications/{applicationId}": {
      "get": {
        "tags": ["Customer Applications"],
        "summary": "Get Application Details",
        "description": "Retrieve full details and all attached documents for a specific application",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "cmt8pm1210001mcycos1l034k"
          }
        ],
        "responses": {
          "200": { "description": "Application details" },
          "404": { "description": "Application not found" }
        }
      },
      "put": {
        "tags": ["Customer Applications"],
        "summary": "Update Application",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateApplicationDto" }
            }
          }
        },
        "responses": {
          "200": { "description": "Application updated" }
        }
      }
    },
    "/customer/documents": {
      "get": {
        "tags": ["Customer Documents"],
        "summary": "Get All Grouped Documents (Document Center)",
        "description": "Returns all customer applications grouped with their uploaded documents, status, and download links",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Grouped applications with documents" }
        }
      }
    },
    "/customer/applications/{applicationId}/documents/upload": {
      "post": {
        "tags": ["Customer Documents"],
        "summary": "Upload and Encrypt Application Document (AES-256-GCM)",
        "description": "Direct upload endpoint that encrypts the document on-the-fly and saves metadata to PostgreSQL. Allows up to 10MB per file.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DirectUploadDocumentDto" }
            }
          }
        },
        "responses": {
          "200": { "description": "Document encrypted and saved successfully" },
          "400": { "description": "Validation error or file exceeds 10MB" }
        }
      }
    },
    "/customer/documents/download-stream": {
      "get": {
        "tags": ["Customer Documents"],
        "summary": "Stream Decrypted Document",
        "description": "Decrypts an AES-256 encrypted file and streams it directly to the browser for inline preview or download",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Storage path of the encrypted document",
            "example": "documents/cust_default_amman_2026/cmt8pm1210001mcycos1l034k/NATIONAL_ID_PROOF_1787665051487_aadhaar_card_scan.pdf"
          }
        ],
        "responses": {
          "200": {
            "description": "Decrypted binary document stream (PDF / Image)",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "403": { "description": "Access denied / unauthorized customer" }
        }
      }
    },
    "/customer/applications/{applicationId}/documents/{documentId}": {
      "get": {
        "tags": ["Customer Documents"],
        "summary": "Get Single Document Details",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "applicationId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Document details with downloadUrl" }
        }
      },
      "delete": {
        "tags": ["Customer Documents"],
        "summary": "Delete Document",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "applicationId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Document deleted" }
        }
      }
    },
    "/admin/applications/{applicationId}/documents": {
      "get": {
        "tags": ["Admin Verification Desk"],
        "summary": "Admin: List Documents for Application",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "applicationId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Application documents for verification" }
        }
      }
    },
    "/admin/applications/{applicationId}/documents/{documentId}/status": {
      "put": {
        "tags": ["Admin Verification Desk"],
        "summary": "Admin: Update Document Verification Status",
        "description": "Verify or reject a customer document. If rejected, a rejectionReason is attached.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "applicationId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateDocumentStatusDto" }
            }
          }
        },
        "responses": {
          "200": { "description": "Document status updated" }
        }
      }
    }
  }
}
