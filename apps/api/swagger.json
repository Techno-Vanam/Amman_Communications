    "/v1/admin/settings/business-profile/logo": {
      "post": {
        "description": "Accepts PNG, JPG, JPEG, WebP up to 5MB.",
        "operationId": "BusinessProfileController_uploadLogo",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file (PNG, JPG, JPEG, WebP)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Logo successfully uploaded."
          },
          "400": {
            "description": "Invalid file type or size."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Admins only"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload or Replace Business Logo",
        "tags": [
          "Admin - Business Profile Settings"
        ]
      },
