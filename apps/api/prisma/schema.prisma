generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ACTION_REQUIRED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Customer {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  applications Application[]
  documents    Document[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Application {
  id                String            @id @default(cuid())
  applicationNumber String            @unique
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId        String
  title             String?
  serviceType       String
  fullName          String?
  email             String?
  phone             String?
  dateOfBirth       String?
  nationality       String?
  address           String?
  notes             String?
  status            ApplicationStatus @default(DRAFT)
  documents         Document[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Document {
  id               String         @id @default(cuid())
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId       String
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId    String
  documentType     String
  originalFileName String?
  fileName         String
  storagePath      String
  fileUrl          String?
  mimeType         String
  fileSize         Int
  isEncrypted      Boolean        @default(true)
  status           DocumentStatus @default(UPLOADED)
  version          Int            @default(1)
  verifiedAt       DateTime?
  verifiedBy       String?
  rejectionReason  String?
  uploadedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([applicationId, documentType])
}
