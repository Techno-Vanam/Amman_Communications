generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model Customer {
  id                 String         @id @default(cuid())
  email              String         @unique
  phone              String?
  passwordHash       String
  name               String
  address            String?
  contactNumber      String?
  dob                String?
  aadhaarNumber      String?
  panNumber          String?
  occupation         String?
  altPhone           String?
  emergencyContact   String?
  isProfileCompleted Boolean        @default(false)
  status             CustomerStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokenHash   String?
  applications       Application[]
  appointments       Appointment[]
  documents          Document[]
  invoices           Invoice[]
  payments           Payment[]
}

model Admin {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  name             String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refreshTokenHash String?
  adminSettings    AdminSettings?
  expenses         Expense[]
}

model Application {
  id                String            @id @default(cuid())
  applicationNumber String?           @unique
  customerId        String
  serviceId         String?
  title             String?
  serviceType       String?
  fullName          String?
  email             String?
  phone             String?
  dateOfBirth       String?
  nationality       String?
  address           String?
  notes             String?
  status            ApplicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service           Service?          @relation(fields: [serviceId], references: [id])
  documents         Document[]
  invoices          Invoice[]
}

model Document {
  id                  String                     @id @default(cuid())
  customerId          String
  applicationId       String
  documentType        String
  storagePath         String
  fileName            String
  mimeType            String
  fileSize            Int
  originalFileName    String?
  version             Int                        @default(1)
  isEncrypted         Boolean                    @default(false)
  status              DocumentStatus             @default(UPLOADED)
  rejectionReason     String?
  verificationStatus  DocumentVerificationStatus @default(PENDING)
  verificationRemarks String?
  uploadedAt          DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  fileUrl             String?
  verifiedAt          DateTime?
  verifiedBy          String?
  application         Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  customer            Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, documentType])
}

model Service {
  id                      String             @id @default(cuid())
  name                    String
  description             String?
  governmentFee           Decimal            @db.Decimal(10, 2)
  serviceFee              Decimal            @db.Decimal(10, 2)
  totalFee                Decimal            @db.Decimal(10, 2)
  estimatedTime           String?
  isPartialPaymentAllowed Boolean            @default(false)
  minimumPartialFee       Decimal?           @db.Decimal(10, 2)
  status                  ServiceStatus      @default(DRAFT)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  applications            Application[]
  appointments            Appointment[]
  invoices                Invoice[]
  requiredDocuments       RequiredDocument[]
}

model Office {
  id           String        @id @default(uuid())
  name         String
  address      String
  isActive     Boolean       @default(true)
  appointments Appointment[]
}

model Appointment {
  id                String                @id @default(cuid())
  appointmentNumber String?               @unique
  customerId        String?
  customerName      String
  customerEmail     String
  email             String?
  customerPhone     String
  serviceId         String?
  officeId          String?
  appointmentDate   DateTime
  preferredDate     DateTime?
  preferredTime     String?
  durationMinutes   Int                   @default(30)
  mode              AppointmentMode       @default(OFFLINE)
  appointmentType   AppointmentType       @default(OFFICE_VISIT)
  onlineType        OnlineMeetingType?
  consultationMode  ConsultationMode?
  meetingLink       String?
  status            AppointmentStatus     @default(CONFIRMED)
  notes             String?
  rescheduledFrom   DateTime?
  rescheduleReason  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  customer          Customer?             @relation(fields: [customerId], references: [id])
  office            Office?               @relation(fields: [officeId], references: [id])
  service           Service?              @relation(fields: [serviceId], references: [id])
  documents         AppointmentDocument[]
}

model BusinessProfile {
  id                 String   @id @default(cuid())
  businessName       String
  registrationNumber String?
  officeAddress      String
  primaryPhone       String
  supportEmail       String
  logoUrl            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RequiredDocument {
  id           String   @id @default(cuid())
  serviceId    String
  name         String
  displayOrder Int      @default(0)
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String          @id @default(cuid())
  title         String
  description   String?
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(10, 2)
  expenseDate   DateTime
  paymentMethod PaymentMethod?
  isVoided      Boolean         @default(false)
  notes         String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     Admin           @relation(fields: [createdById], references: [id])

  @@index([expenseDate])
  @@index([category])
}

model AppointmentCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model AppointmentDocument {
  id            String      @id @default(cuid())
  appointmentId String
  documentType  String
  fileType      String?
  fileSize      Int?
  fileUrl       String
  fileName      String
  uploadedAt    DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  applicationId String?
  serviceId     String?
  governmentFee Decimal       @db.Decimal(10, 2)
  serviceFee    Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  application   Application?  @relation(fields: [applicationId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       Service?      @relation(fields: [serviceId], references: [id])
  payments      Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  invoiceId     String
  customerId    String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  status        PaymentStatus @default(PAID)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([paidAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model ManualSale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  customerName  String
  customerPhone String?
  category      SaleCategory  @default(OTHER)
  amount        Decimal       @db.Decimal(10, 2)
  details       String?
  status        PaymentStatus @default(PAID)
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
}

model AdminSettings {
  id             String   @id @default(cuid())
  adminId        String   @unique
  emailAlerts    Boolean  @default(true)
  smsAlerts      Boolean  @default(true)
  whatsappAlerts Boolean  @default(true)
  weeklyDigest   Boolean  @default(false)
  language       String   @default("English")
  timezone       String   @default("Asia/Kolkata (IST +5:30)")
  autoLogout     String   @default("30 minutes")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String               @id @default(cuid())
  title     String
  message   String
  type      NotificationType     @default(INFO)
  isRead    Boolean              @default(false)
  href      String?
  userId    String?
  userType  NotificationUserType @default(ADMIN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId, userType, isRead])
  @@index([createdAt])
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ACTION_REQUIRED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum AppointmentType {
  OFFICE_VISIT
  ONLINE_CONSULTATION
}

enum ConsultationMode {
  PHONE
  VIDEO
  WHATSAPP
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AppointmentMode {
  OFFLINE
  ONLINE
}

enum OnlineMeetingType {
  PHONE
  VIDEO
  MEETING
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ExpenseCategory {
  OFFICE
  TRAVEL
  EMPLOYEE
  PROPERTY
  UTILITIES
  MARKETING
  EQUIPMENT
  OTHER
}

enum SaleCategory {
  APPLICATION
  XEROX
  STATIONARY
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationUserType {
  ADMIN
  CUSTOMER
}
