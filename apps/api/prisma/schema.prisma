generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Customer {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  applications Application[]
  documents    Document[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Application {
  id         String     @id @default(cuid())
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  service    Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId  String?
  documents  Document[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Document {
  id                  String                    @id @default(cuid())
  customer            Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId          String
  application         Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId       String
  documentType        String
  storagePath         String
  fileName            String
  mimeType             String
  fileSize            Int
  verificationStatus  DocumentVerificationStatus @default(PENDING)
  verificationRemarks String?
  uploadedAt          DateTime                  @default(now())
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Service {
  id                String             @id @default(cuid())
  name              String
  description       String?
  governmentFee     Decimal            @db.Decimal(10, 2)
  serviceFee        Decimal            @db.Decimal(10, 2)
  totalFee          Decimal            @db.Decimal(10, 2)
  estimatedTime     String?
  status            ServiceStatus      @default(DRAFT)
  requiredDocuments RequiredDocument[]
  applications      Application[]
  appointments      Appointment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model RequiredDocument {
  id           String   @id @default(cuid())
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId    String
  name         String
  displayOrder Int      @default(0)
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AppointmentMode {
  OFFLINE
  ONLINE
}

enum OnlineMeetingType {
  PHONE
  VIDEO
  MEETING
}

model Appointment {
  id               String            @id @default(cuid())
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId       String?
  customerName     String
  customerEmail    String
  customerPhone    String
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId        String?
  appointmentDate  DateTime
  durationMinutes  Int               @default(30)
  mode             AppointmentMode   @default(OFFLINE)
  onlineType       OnlineMeetingType?
  meetingLink      String?
  status           AppointmentStatus @default(CONFIRMED)
  notes            String?
  rescheduledFrom  DateTime?
  rescheduleReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

