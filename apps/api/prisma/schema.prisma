// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  timestamp DateTime @default(now())
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum AppointmentType {
  OFFICE_VISIT
  ONLINE_CONSULTATION
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ACTION_REQUIRED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  role      String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Customer {
  id                 String         @id @default(cuid())
  email              String?        @unique
  phone              String?
  passwordHash       String
  name               String
  address            String?
  contactNumber      String?
  dob                String?
  aadhaarNumber      String?
  panNumber          String?
  occupation         String?
  altPhone           String?
  emergencyContact   String?
  isProfileCompleted Boolean        @default(false)
  applications       Application[]
  documents          Document[]
  appointments       Appointment[]
  invoices           Invoice[]
  payments           Payment[]
  status             CustomerStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Admin {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           String         @default("ADMIN")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  expenses       Expense[]
  settings       AdminSettings?
}

model Application {
  id                String            @id @default(cuid())
  applicationNumber String            @unique
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId        String
  service           Service           @relation(fields: [serviceId], references: [id])
  serviceId         String
  status            ApplicationStatus @default(SUBMITTED)
  
  fullName          String
  mobileNumber      String
  email             String?
  dateOfBirth       String?
  gender            String?
  address           String?
  notes             String?
  rejectionReason   String?
  
  formData          Json?
  metadata          Json?
  
  documents         Document[]
  invoices          Invoice[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
}

model Document {
  id              String         @id @default(cuid())
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String
  
  documentType    String
  fileName        String
  fileSize        Int
  mimeType        String
  storagePath     String
  status          DocumentStatus @default(UPLOADED)
  version         Int            @default(1)
  rejectionReason String?
  
  uploadedAt      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([applicationId])
  @@index([customerId])
  @@index([status])
}

model Appointment {
  id                String                @id @default(cuid())
  appointmentNumber String?               @unique
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId        String
  service           Service?              @relation(fields: [serviceId], references: [id])
  serviceId         String?
  
  appointmentDate   DateTime
  timeSlot          String
  status            AppointmentStatus     @default(PENDING)
  appointmentType   AppointmentType       @default(OFFICE_VISIT)
  mode              AppointmentMode       @default(OFFLINE)
  onlineType        OnlineMeetingType?
  meetingLink       String?
  
  office            Office?               @relation(fields: [officeId], references: [id])
  officeId          String?
  
  notes             String?
  cancellationReason String?
  rescheduledCount  Int                   @default(0)
  documents         AppointmentDocument[]
  
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([customerId])
  @@index([appointmentDate])
  @@index([status])
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Service {
  id                      String             @id @default(cuid())
  name                    String
  description             String?
  governmentFee           Decimal            @db.Decimal(10, 2)
  serviceFee              Decimal            @db.Decimal(10, 2)
  totalFee                Decimal            @db.Decimal(10, 2)
  estimatedTime           String?
  isPartialPaymentAllowed Boolean            @default(false)
  minimumPartialFee       Decimal?           @db.Decimal(10, 2)
  status                  ServiceStatus      @default(DRAFT)
  requiredDocuments       RequiredDocument[]
  applications            Application[]
  appointments            Appointment[]
  invoices                Invoice[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model Office {
  id           String        @id @default(uuid())
  name         String
  address      String
  isActive     Boolean       @default(true)
  appointments Appointment[]
}

enum AppointmentMode {
  OFFLINE
  ONLINE
}

enum OnlineMeetingType {
  PHONE
  VIDEO
  MEETING
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model RequiredDocument {
  id           String   @id @default(cuid())
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId    String
  name         String
  displayOrder Int      @default(0)
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ExpenseCategory {
  OFFICE
  TRAVEL
  EMPLOYEE
  PROPERTY
  UTILITIES
  MARKETING
  EQUIPMENT
  OTHER
}

model Expense {
  id            String         @id @default(cuid())
  title         String
  description   String?
  category      String
  amount        Decimal        @db.Decimal(10, 2)
  expenseDate   DateTime
  paymentMethod PaymentMethod?
  isVoided      Boolean        @default(false)
  notes         String?
  
  createdById   String
  createdBy     Admin          @relation(fields: [createdById], references: [id])
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([expenseDate])
  @@index([category])
}

model AppointmentCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model AppointmentDocument {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  documentType  String
  fileType      String?
  fileSize      Int?
  fileUrl       String
  fileName      String
  uploadedAt    DateTime    @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationId String?
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId     String?
  
  governmentFee Decimal       @db.Decimal(10, 2)
  serviceFee    Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime?
  notes         String?
  
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  status        PaymentStatus @default(PAID)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([paidAt])
}

enum SaleCategory {
  APPLICATION
  XEROX
  STATIONARY
  OTHER
}

model ManualSale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  customerName  String
  customerPhone String?
  category      SaleCategory  @default(OTHER)
  amount        Decimal       @db.Decimal(10, 2)
  details       String?
  status        PaymentStatus @default(PAID)
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model AdminSettings {
  id             String   @id @default(cuid())
  adminId        String   @unique
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  emailAlerts    Boolean  @default(true)
  smsAlerts      Boolean  @default(true)
  whatsappAlerts Boolean  @default(true)
  weeklyDigest   Boolean  @default(false)
  language       String   @default("English")
  timezone       String   @default("Asia/Kolkata (IST +5:30)")
  autoLogout     String   @default("30 minutes")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BusinessProfile {
  id                 String   @id @default(cuid())
  businessName       String   @default("")
  registrationNumber String?
  officeAddress      String?
  primaryPhone       String?
  supportEmail       String?
  logoUrl            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
