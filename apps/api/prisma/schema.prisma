generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ACTION_REQUIRED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  address      String?
  contactNumber String?
  applications Application[]
  documents    Document[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  expenses     Expense[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Application {
  id                String            @id @default(cuid())
  applicationNumber String?           @unique
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId        String
  service           Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId         String?
  title             String?
  serviceType       String?
  fullName          String?
  email             String?
  phone             String?
  dateOfBirth       String?
  nationality       String?
  address           String?
  notes             String?
  status            ApplicationStatus @default(DRAFT)
  documents         Document[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Document {
  id                  String                    @id @default(cuid())
  customer            Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId          String
  application         Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId       String
  documentType        String
  storagePath         String
  fileName            String
  mimeType            String
  fileSize            Int
  verificationStatus  DocumentVerificationStatus @default(PENDING)
  verificationRemarks String?
  uploadedAt          DateTime                  @default(now())
}

enum AppointmentType {
  OFFICE_VISIT
  ONLINE_CONSULTATION
}

enum ConsultationMode {
  PHONE
  VIDEO
  WHATSAPP
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

model Service {
  id                      String        @id @default(uuid())
  name                    String
  description             String?
  requiredDocuments       Json          // string[] of document type codes
  governmentFee            Decimal?
  officeCharge             Decimal?
  estimatedProcessingTime  String?
  isActive                 Boolean       @default(true)
  createdAt                DateTime      @default(now())
  appointments             Appointment[]
}

model Office {
  id           String        @id @default(uuid())
  name         String
  address      String
  isActive     Boolean       @default(true)
  appointments Appointment[]
}

model AppointmentCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model Appointment {
  id                 String             @id @default(uuid())
  appointmentNumber  String             @unique   // e.g. APT-2026-000123
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId          String
  service            Service            @relation(fields: [serviceId], references: [id])
  appointmentType    AppointmentType
  officeId           String?            // required if OFFICE_VISIT
  office             Office?            @relation(fields: [officeId], references: [id])
  consultationMode   ConsultationMode?  // required if ONLINE_CONSULTATION
  preferredDate      DateTime
  preferredTime      String             // "HH:mm"
  contactNumber      String
  name               String
  email              String?
  address            String?
  notes              String?
  status             AppointmentStatus  @default(PENDING)

  // Reschedule tracking
  originalDate       DateTime?
  originalTime       String?
  rescheduleReason   String?
  adminNote          String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  documents          AppointmentDocument[]
  statusHistory      AppointmentStatusHistory[]
}

model AppointmentDocument {
  id             String       @id @default(uuid())
  appointmentId  String
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileName       String
  fileType       String       // pdf | jpg | png
  fileSize       Int
  uploadedAt     DateTime     @default(now())
}

model AppointmentStatusHistory {
  id             String       @id @default(uuid())
  appointmentId  String
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status         AppointmentStatus
  changedBy      String       // admin id or "system" or customerId
  remarks        String?
  changedAt      DateTime     @default(now())
}
