NODE_ENV=development
DATABASE_URL=postgresql://postgres:change-me-locally@localhost:5432/business_platform?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:change-me-locally@localhost:5432/business_platform?schema=public
PORT=3003
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── File Storage ─────────────────────────────────────────────────────────────
# Choose your provider: firebase | s3 | azure | gcp
# Changing this single variable is all you need to switch cloud providers.
STORAGE_PROVIDER=firebase

# Firebase Storage (STORAGE_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# AWS S3 (STORAGE_PROVIDER=s3)
# Also works with MinIO, Cloudflare R2, Backblaze B2 — set AWS_S3_ENDPOINT for those.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=   # optional — only for S3-compatible providers (MinIO, R2, etc.)

# Azure Blob Storage (STORAGE_PROVIDER=azure)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=

# GCP Cloud Storage (STORAGE_PROVIDER=gcp)
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_STORAGE_BUCKET=

# ─── Other ─────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
CORS_ALLOWED_ORIGINS=http://localhost:3000
SENTRY_DSN=
