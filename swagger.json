  "info": {
    "title": "Amman Communications API",
    "description": "API documentation and interactive endpoint specification for Amman Communications Business Platform.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter Admin JWT access token"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Account email address",
            "example": "admin@test.com"
          },
          "password": {
            "type": "string",
            "description": "Account password",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the user",
            "example": "Test Customer"
          },
          "email": {
            "type": "string",
            "description": "Account email address",
            "example": "customer@test.com"
          },
          "password": {
            "type": "string",
            "description": "Account password",
            "example": "password123"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "RequiredDocumentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Required document ID",
            "example": "doc-1"
          },
          "name": {
            "type": "string",
            "description": "Document name",
            "example": "Commercial License Copy"
          },
          "displayOrder": {
            "type": "number",
            "description": "Display order index",
            "example": 1
          },
          "isRequired": {
            "type": "boolean",
            "description": "Is this document mandatory",
            "example": true
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateServiceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Service title",
            "example": "Commercial Fiber Connectivity"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the service",
            "example": "High-speed dedicated commercial fiber connectivity."
          },
          "governmentFee": {
            "type": "number",
            "description": "Government processing fee",
            "example": 250
          },
          "serviceFee": {
            "type": "number",
            "description": "Service provider fee",
            "example": 750
          },
          "estimatedTime": {
            "type": "string",
            "description": "Estimated fulfillment timeframe",
            "example": "2-3 Working Days"
          },
          "status": {
            "type": "string",
            "description": "Service publishing status",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "INACTIVE"
            ],
            "example": "ACTIVE"
          },
          "requiredDocuments": {
            "description": "List of required documents",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequiredDocumentDto"
            }
          }
        },
        "required": [
          "name",
          "governmentFee",
          "serviceFee"
        ]
      },
      "UpdateServiceDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateServiceStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "New status for the service",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "INACTIVE"
            ],
            "example": "ACTIVE"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateAppointmentDto": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "description": "Full name of the customer",
            "example": "Test Customer"
          },
          "customerEmail": {
            "type": "string",
            "description": "Customer email address",
            "example": "customer@test.com"
          },
          "customerPhone": {
            "type": "string",
            "description": "Customer contact phone number",
            "example": "+91 9876543210"
          },
          "customerId": {
            "type": "string",
            "description": "Customer ID if registered",
            "example": "cust-123"
          },
          "serviceId": {
            "type": "string",
            "description": "Associated Service ID",
            "example": "serv-456"
          },
          "appointmentDate": {
            "type": "string",
            "description": "ISO Date string for appointment",
            "example": "2026-09-01T10:00:00.000Z"
          },
          "durationMinutes": {
            "type": "number",
            "description": "Duration in minutes",
            "example": 30
          },
          "mode": {
            "type": "string",
            "description": "Appointment mode",
            "enum": [
              "OFFLINE",
              "ONLINE"
            ],
            "example": "OFFLINE"
          },
          "onlineType": {
            "type": "string",
            "description": "Online meeting channel type",
            "enum": [
              "PHONE",
              "VIDEO",
              "MEETING"
            ],
            "example": "PHONE"
          },
          "meetingLink": {
            "type": "string",
            "description": "Meeting URL for online appointments",
            "example": "https://meet.google.com/abc-defg-hij"
          },
          "status": {
            "type": "string",
            "description": "Initial appointment status",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "COMPLETED",
              "CANCELLED",
              "RESCHEDULED"
            ],
            "example": "CONFIRMED"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes or instructions",
            "example": "Discuss commercial fiber deployment schedule."
          }
        },
        "required": [
          "customerName",
          "customerEmail",
          "customerPhone",
          "appointmentDate",
          "mode"
        ]
      },
      "UpdateAppointmentDto": {
        "type": "object",
        "properties": {}
      },
      "RescheduleAppointmentDto": {
        "type": "object",
        "properties": {
          "newDate": {
            "type": "string",
            "description": "New proposed date/time ISO string",
            "example": "2026-09-05T14:00:00.000Z"
          },
          "reason": {
            "type": "string",
            "description": "Reason for rescheduling",
            "example": "Customer requested afternoon slot."
          },
          "mode": {
            "type": "string",
            "description": "Updated appointment mode",
            "enum": [
              "OFFLINE",
              "ONLINE"
            ],
            "example": "ONLINE"
          },
          "onlineType": {
            "type": "string",
            "description": "Online meeting channel type",
            "enum": [
              "PHONE",
              "VIDEO",
              "MEETING"
            ],
            "example": "VIDEO"
          },
          "meetingLink": {
            "type": "string",
            "description": "Meeting link if mode is online",
            "example": "https://meet.google.com/xyz-uvwx-rst"
          },
          "notes": {
            "type": "string",
            "description": "Updated notes",
            "example": "Rescheduled per customer email."
          }
        },
        "required": [
          "newDate"
        ]
